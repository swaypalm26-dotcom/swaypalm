    "UserAuthLink": {
      "title": "UserAuthLink",
      "description": "Immutable 1-to-1 lookup mapping a Firebase Auth UID to an immutable User UUID (zero PII).",
      "type": "object",
      "properties": {
        "auth_uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "user_id": { "type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["auth_uid", "user_id", "createdAt"]
    },
    "User": {
      "title": "User",
